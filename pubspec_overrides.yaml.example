# Copy this to pubspec_overrides.yaml (gitignored, not this file) to
# develop against local sibling checkouts instead of their tagged git
# refs — same idea as .env.example, see CONTRIBUTING.md. Overriding all
# five here (not just fluxer_dart) means a change anywhere in the
# ecosystem is picked up, since dependency_overrides apply to the whole
# resolved graph, including fluxer_dart's own transitive deps on these.
dependency_overrides:
  fluxer_dart:
    path: ../fluxer_dart
  fluxer_dart_core:
    path: ../fluxer_dart_core
  fluxer_dart_gateway:
    path: ../fluxer_dart_gateway
  fluxer_dart_rest:
    path: ../fluxer_dart_rest
  fluxer_dart_utils:
    path: ../fluxer_dart_utils
